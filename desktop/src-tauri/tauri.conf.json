{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UniDeer",
  "version": "2.1.0",
  "identifier": "tech.unideer.desktop",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://127.0.0.1:3000",
    "beforeBuildCommand": "",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "UniDeer",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 650,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_TAURI_SIGNING_PUBLIC_KEY",
      "endpoints": [
        "https://github.com/YOUR_ORG/uni-deer/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/deerflow-backend"]
  }
}
